x29x0          |-(cw*pow(sw,-1))                                                                                               % W-.C Z.c  W+    coupling.
x30x0          |-0.25*(vev*pow(cw,-1)*pow(sw,-2)*(pow(cw,2)+pow(sw,2)))                                                        % Z.C  W-.c W+.f  coupling.
