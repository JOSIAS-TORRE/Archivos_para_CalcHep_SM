x32x0          |(vev*pow(cw,-1)*(1+pow(cw,2)*pow(sw,-2)))/4.                                                                   % Z.C  W+.c W-.f  coupling.
x33x0          |-(cw*pow(sw,-1))                                                                                               % Z.C  W+.c W-    coupling.
x34x0          |-0.25*(vev*pow(cw,-2)*pow(sw,-2)*pow(pow(cw,2)+pow(sw,2),2))                                                   % Z.C  Z.c  H     coupling.
x35x0          |1                                                                                                              % g.C  g.c  g     coupling.
